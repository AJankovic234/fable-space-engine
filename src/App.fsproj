    <Compile Include="Math3D.fs" />
    <Compile Include="CombatVfx.fs" />
    <Compile Include="PilotSkills.fs" />
    <Compile Include="Universe.fs" />
    <Compile Include="CapitalFlight.fs" />
    <Compile Include="Recovery.fs" />
    <Compile Include="TradeSystem.fs" />
    <Compile Include="WebGLRenderer.fs" />
    <Compile Include="GlbLoader.fs" />
    <Compile Include="ProceduralMeshes.fs" />
    <Compile Include="AsteroidMeshes.fs" />
    <Compile Include="Traffic.fs" />
    <Compile Include="CapitalMeshes.fs" />
    <Compile Include="SovereignMeshes.fs" />
    <Compile Include="LandmarkMeshes.fs" />
    <Compile Include="StationMeshes.fs" />
    <Compile Include="StationCollision.fs" />
    <Compile Include="EnemyMeshes.fs" />
    <Compile Include="PlayerMeshes.fs" />
    <Compile Include="UpgradeMeshes.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="PhysicsAndPool.fs" />
    <Compile Include="JumpFlight.fs" />
    <Compile Include="Salvage.fs" />
    <Compile Include="EnemyProfiles.fs" />
    <Compile Include="TradeRoutes.fs" />
    <Compile Include="Freight.fs" />
    <Compile Include="ShipCatalog.fs" />
    <Compile Include="OutfitVisuals.fs" />
    <Compile Include="Mission.fs" />
    <Compile Include="Economy.fs" />
    <Compile Include="Blockade.fs" />
    <Compile Include="Turret.fs" />
    <Compile Include="AI.fs" />
    <Compile Include="Encounters.fs" />
    <Compile Include="FlightSchool.fs" />
    <Compile Include="Camera.fs" />
    <Compile Include="CombatFeedback.fs" />
    <Compile Include="SkyBackdrop.fs" />
    <Compile Include="Sound.fs" />
    <Compile Include="StoryRadio.fs" />
    <Compile Include="DockContact.fs" />
    <Compile Include="GameSave.fs" />
    <Compile Include="SaveStore.fs" />
    <Compile Include="SaveUi.fs" />
    <Compile Include="HudLayout.fs" />
    <Compile Include="HudContacts.fs" />
